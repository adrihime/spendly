# Production environment for docker-compose.prod.yml
# Copy to .env in this same folder and fill in. Never commit .env (it is gitignored).
# `docker compose` loads this file automatically for ${VAR} substitution.

# Google OAuth client ID — the same value the frontend was built with (VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# The only Google account allowed to sign in.
OWNER_EMAIL=you@example.com

# Secret for signing session cookies. Generate once: openssl rand -hex 32
SESSION_SECRET=

# Origins allowed by CORS — the deployed frontend URL, comma-separated if more than one.
# GitHub Pages default: https://<user>.github.io
FRONTEND_ORIGINS=

# Cloudflare Tunnel token: Zero Trust > Networks > Tunnels > (tunnel) > Configure > Docker.
CLOUDFLARE_TUNNEL_TOKEN=
